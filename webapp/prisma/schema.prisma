// AVP_ERP — schema nền tảng
// Nguồn: docs/features/FID-ERP-001_20260917.md (v1.4, APPROVED 2026-09-17)
// KHÔNG sửa file này mà không cập nhật FID-ERP-001 tương ứng.

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum MoveType {
  RECEIVE
  SELECT
  PACK
  SHIP
  SCRAP
  RETURN
  REWORK // v1.5 (FID-ERP-001) — hàng lỗi TRONG lúc lựa nhưng CÒN DÙNG ĐƯỢC, tạm giữ chờ xử lý lại (khác RETURN/FID-ERP-007 — Traveler ĐÃ xuất bị trả lại)
}

// v1.6 (FID-ERP-001) — cổng QC/workflow ở khâu Wrapping (FID-ERP-005),
// KHÔNG phải chuyển động số lượng nên KHÔNG dùng chung stock_moves (bảng
// đó bắt buộc qty>0) — tách bảng riêng, cùng triết lý append-only.
enum QualityStatus {
  GOOD
  HOLD
}

model Lot {
  lotNo       String   @id @map("lot_no") // vd "6-251-15-A"
  parentLotNo String?  @map("parent_lot_no") // hỗ trợ split lot (vd "6-251-15" -> "6-251-15-A")
  createdAt   DateTime @default(now()) @map("created_at")

  parentLot Lot?       @relation("LotSplit", fields: [parentLotNo], references: [lotNo])
  childLots Lot[]      @relation("LotSplit")
  travelers Traveler[]

  @@index([parentLotNo])
  @@map("lots")
}

model DefectType {
  code  String @id // vd "LOOSE_WASHER_NUT"
  label String @unique // vd "Loose Washer Nut" — 10 giá trị thật, xem FID-ERP-001 §5

  stockMoves StockMove[]

  @@map("defect_types")
}

model Traveler {
  travelerNo String   @id @map("traveler_no")
  partNo     String   @map("part_no")
  poNo       String?  @map("po_no") // 1 PO có thể trải trên NHIỀU Traveler
  potNo      String?  @map("pot_no") // GAYLORD — link Rework/Return, FID-ERP-007
  lotNo      String?  @map("lot_no") // 1 Traveler = 1 Lot (xác nhận bằng dữ liệu thật, xem FID-ERP-001 v1.3)
  createdAt  DateTime @default(now()) @map("created_at")
  // KHÔNG có qcStatus cache — trạng thái tính qua VIEW traveler_last_select_status hoặc query stock_moves

  // v1.7 (FID-ERP-001) — cờ Concession khi xuất với Lot còn placeholder
  // (FID-ERP-006). MUTABLE (giống poNo/potNo/lotNo — chỉ là thông tin
  // định danh, không phải sổ cái số lượng/trạng thái), KHÔNG cần
  // append-only riêng — khác lịch sử ĐỔI Lot (xem LotUpdate, append-only).
  lotConcessionBy     String?   @map("lot_concession_by")
  lotConcessionReason String?   @map("lot_concession_reason")
  lotConcessionAt     DateTime? @map("lot_concession_at")

  // v1.8 (FID-ERP-001) — Rework/Return linkage (FID-ERP-007). MUTABLE
  // (cờ định danh, không phải sổ cái — giống lotConcession*). Số lượng
  // thật quay lại xử lý ghi ở stock_moves (moveType=RETURN, đúng lúc lựa
  // lại xong ở FID-ERP-003), KHÔNG ghi ở đây.
  isReturnForRework Boolean @default(false) @map("is_return_for_rework")
  reworkOfPsNo      String? @map("rework_of_ps_no") // best-effort, tra qua FK thật — có thể NULL
  reworkOfLotNo     String? @map("rework_of_lot_no") // best-effort, tra qua FK thật — có thể NULL

  // v1.10 (FID-ERP-001) — Skid# (FID-ERP-005 v1.1). MUTABLE (giống potNo)
  // — ghi nhận lúc đóng thùng (PACK) ở khâu Wrapping, dữ liệu thật xác
  // nhận cùng 1 dòng với Good/Hold (`Data/4.WRAPPING/Wrapping_final.xlsm`
  // CHECKING SUMMARY, cột SKID#).
  skidNo String? @map("skid_no")

  part          PartControl       @relation(fields: [partNo], references: [partNo])
  lot           Lot?              @relation(fields: [lotNo], references: [lotNo])
  moves         StockMove[]
  packingLines  PackingSlipLine[]
  printLogs     PrintLog[]
  qualityChecks QualityCheck[]
  lotUpdates    LotUpdate[]

  @@map("travelers")
}

/// SỔ CÁI BẤT BIẾN — append-only, KHÔNG UPDATE/DELETE (chặn ở tầng DB qua trigger, xem migration)
model StockMove {
  id            Int       @id @default(autoincrement())
  travelerNo    String    @map("traveler_no")
  moveType      MoveType  @map("move_type")
  qty           Int // LUÔN DƯƠNG — ý nghĩa +/- suy từ moveType (xem FID-ERP-001 §5)
  machineCode   String?   @map("machine_code") // NOT NULL khi SELECT/PACK — chuẩn hoá TRIM+UPPER khi ghi
  operatorCode  String?   @map("operator_code") // NOT NULL khi SELECT/PACK
  shift         String? // NOT NULL khi SELECT/PACK
  reasonCode    String?   @map("reason_code") // FK -> defect_types; NOT NULL khi SCRAP
  potNo         String?   @map("pot_no") // dùng khi RETURN, link GAYLORD
  sourceStation String?   @map("source_station") // "OFFICE" | "FACTORY" | "ADMIN"
  deviceId      String?   @map("device_id") // vd "OFFICE-PC-01"
  note          String? // v1.5 (FID-ERP-001) — ghi chú tự do, dùng cho REWORK (lý do giữ lại chờ xử lý)
  boxCount      Int?      @map("box_count") // v1.10 (FID-ERP-001) — số thùng, dùng cho PACK (FID-ERP-005 v1.1)
  createdAt     DateTime  @default(now()) @map("created_at")
  // KHÔNG có updatedAt — bảng bất biến

  traveler   Traveler    @relation(fields: [travelerNo], references: [travelerNo])
  defectType DefectType? @relation(fields: [reasonCode], references: [code])

  @@index([travelerNo])
  @@index([moveType, createdAt])
  @@index([machineCode, createdAt])
  @@index([createdAt])
  @@map("stock_moves")
}

model PartControl {
  partNo    String @id @map("part_no")
  qtyPerBox Int    @map("qty_per_box")
  client    String // vd "Infasco"

  travelers Traveler[]

  @@map("part_control")
}

model PackingSlip {
  id           Int      @id @default(autoincrement())
  psNo         String   @unique @map("ps_no")
  totalPallets Int      @default(0) @map("total_pallets")
  totalEmpty   Int      @default(0) @map("total_empty")
  createdAt    DateTime @default(now()) @map("created_at")

  lines PackingSlipLine[]

  @@map("packing_slips")
}

/// Snapshot tại thời điểm tạo PS — chứng từ xuất hàng thật, không đổi theo Traveler sau này
model PackingSlipLine {
  id            Int    @id @default(autoincrement())
  packingSlipId Int    @map("packing_slip_id")
  travelerNo    String @map("traveler_no") // vẫn giữ FK để trace ngược tới Traveler thật
  qty           Int
  partNoSnap    String  @map("part_no_snap")
  lotNoSnap     String? @map("lot_no_snap")
  potNoSnap     String? @map("pot_no_snap")
  skidNoSnap    String? @map("skid_no_snap") // v1.11 (FID-ERP-001) — đóng băng Skid# lúc duyệt PS, FID-ERP-009

  packingSlip PackingSlip @relation(fields: [packingSlipId], references: [id])
  traveler    Traveler    @relation(fields: [travelerNo], references: [travelerNo])

  @@map("packing_slip_lines")
}

/// SỔ CÁI BẤT BIẾN — append-only, KHÔNG UPDATE/DELETE (v1.6, FID-ERP-001).
/// Concession KHÔNG sửa đè dòng Hold cũ — ghi 1 dòng MỚI (status=HOLD +
/// concessionBy/Reason/At) khi được nhượng bộ, đúng triết lý append-only
/// (khác AVP_AI, nơi concession UPDATE thẳng lên dòng cũ).
model QualityCheck {
  id               Int           @id @default(autoincrement())
  travelerNo       String        @map("traveler_no")
  status           QualityStatus
  note             String? // bắt buộc (validate ở API) khi status=HOLD — lý do
  checkedBy        String        @map("checked_by")
  concessionBy     String?       @map("concession_by")
  concessionReason String?       @map("concession_reason")
  concessionAt     DateTime?     @map("concession_at")
  createdAt        DateTime      @default(now()) @map("created_at")
  // KHÔNG có updatedAt — bảng bất biến

  traveler Traveler @relation(fields: [travelerNo], references: [travelerNo])

  @@index([travelerNo, createdAt])
  @@map("quality_checks")
}

/// SỔ CÁI BẤT BIẾN — append-only, KHÔNG UPDATE/DELETE (v1.7, FID-ERP-001).
/// Lịch sử ĐỔI Lot (placeholder → thật, hoặc thật → thật khác nếu
/// Infasco sửa) — Andy xác nhận 2026-09-18: "không sửa đè, ghi audit
/// trail đầy đủ", KHÁC AVP_AI (chỉ ghi lotUpdatedBy/At đè lên dòng cũ,
/// không giữ oldLotNo). `travelers.lotNo` VẪN bị UPDATE (mutable, đọc
/// nhanh — giống poNo/potNo), bảng này chỉ là log riêng, không thay thế.
model LotUpdate {
  id         Int      @id @default(autoincrement())
  travelerNo String   @map("traveler_no")
  oldLotNo   String?  @map("old_lot_no")
  newLotNo   String   @map("new_lot_no")
  updatedBy  String   @map("updated_by")
  createdAt  DateTime @default(now()) @map("created_at")
  // KHÔNG có updatedAt — bảng bất biến

  traveler Traveler @relation(fields: [travelerNo], references: [travelerNo])

  @@index([travelerNo, createdAt])
  @@map("lot_updates")
}

model PrintLog {
  id         Int      @id @default(autoincrement())
  travelerNo String   @map("traveler_no")
  partNo     String   @map("part_no")
  printedBy  String   @map("printed_by") // operator_code
  printedAt  DateTime @default(now()) @map("printed_at")

  traveler Traveler @relation(fields: [travelerNo], references: [travelerNo])

  @@map("print_log")
}

// v1.9 (FID-ERP-001) — FID-ERP-008 (Báo cáo đối chiếu PO). PO Infasco
// KHÔNG ghi hạn tường minh — startDate/endDate do NHÂN VIÊN tự set (không
// OCR/không tự suy đoán ở server). Không dùng chung travelers (N Traveler
// cùng 1 poNo sẽ trùng lặp/dễ lệch) — bảng riêng, KHÔNG append-only (dữ
// liệu kế hoạch, sửa lại bình thường), KHÔNG FK bắt buộc tới travelers
// (nhân viên có thể set ngày trước khi có Traveler nào đăng ký).
model PoTracking {
  poNo      String    @id @map("po_no")
  startDate DateTime? @map("start_date")
  endDate   DateTime? @map("end_date")
  setBy     String?   @map("set_by")
  updatedAt DateTime  @updatedAt @map("updated_at")

  @@map("po_tracking")
}
